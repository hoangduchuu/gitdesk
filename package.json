{
  "name": "gitdesk",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first desktop Git client",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac --dir",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "e2e": "electron-vite build && node scripts/e2e/smoke.cjs",
    "test": "vitest run",
    "postinstall": "node scripts/postinstall.cjs",
    "dist": "electron-vite build && electron-builder --mac",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.49.0",
    "material-icon-theme": "^5.39.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "local.gitdesk",
    "productName": "GitDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "dmg": {
      "title": "GitDesk ${version}"
    }
  }
}
